diff -ru -x '*.pyc' a_orig/android/app/src/main/cpp/jni_entry.cpp a/android/app/src/main/cpp/jni_entry.cpp
--- a_orig/android/app/src/main/cpp/jni_entry.cpp	2026-10-15 19:42:43.860027576 +0000
+++ a/android/app/src/main/cpp/jni_entry.cpp	2026-10-15 19:42:43.924046205 +0000
@@ -2,6 +2,7 @@
 // compiled into the app yet because it embeds Python).
 #include <jni.h>
 #include <stdlib.h>
+#include <unistd.h>
 #include <atomic>
 #include <string>
 #include <thread>
@@ -29,7 +30,11 @@
 
     // Bundled Mozilla CA list (downloaded by the workflow). Works on any
     // Android version, even if the device's own certificate store is old.
-    setenv("SSL_CERT_FILE", (root + "/cacert.pem").c_str(), 1);
+    // Only point at the bundle if it was actually shipped; otherwise a missing file breaks every HTTPS call.
+    {
+        std::string pem = root + "/cacert.pem";
+        if (access(pem.c_str(), R_OK) == 0) setenv("SSL_CERT_FILE", pem.c_str(), 1);
+    }
 
     std::string www     = root + "/www";
     std::string plugins = root + "/plugins";
diff -ru -x '*.pyc' a_orig/backend/server.cpp a/backend/server.cpp
--- a_orig/backend/server.cpp	2026-10-15 19:42:43.856240181 +0000
+++ a/backend/server.cpp	2026-10-15 19:42:43.923552270 +0000
@@ -1,3 +1,4 @@
+#include <unistd.h>
 #include "server.h"
 #include "playback.h"
 #include "torrent_routes.h"
@@ -239,8 +240,12 @@
 // HTTPS to the TMDb proxy. No-op everywhere else.
 #ifdef CPPHTTPLIB_OPENSSL_SUPPORT
 static void applyTls(httplib::Client& c) {
+    // Bundled file (if it really exists) AND the system store, so a missing cacert.pem can't break HTTPS.
     const char* f = std::getenv("SSL_CERT_FILE");
-    if (f && *f) c.set_ca_cert_path(f, "");
+    const char* d = std::getenv("SSL_CERT_DIR");
+    bool hasF = f && *f && access(f, R_OK) == 0;
+    bool hasD = d && *d;
+    if (hasF || hasD) c.set_ca_cert_path(hasF ? f : "", hasD ? d : "");
 }
 #else
 static void applyTls(httplib::Client&) {}
