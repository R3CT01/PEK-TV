<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sized in grid cells, and the picker previews the real layout. Same as xml/music_widget_info.xml otherwise. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_music_description"
    android:initialLayout="@layout/widget_music"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="220dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/widget_music"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
